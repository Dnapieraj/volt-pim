generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  BULK_UPDATE
  ACCOUNT
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(VIEWER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auditLogs     AuditLog[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  ean                String              @default("")
  manufacturerCode   String              @default("")
  name               String
  brand              String              @default("")
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  unit               String              @default("szt.")
  price              Decimal             @db.Decimal(10, 2)
  vat                Int                 @default(23)
  stock              Int                 @default(0)
  minOrder           Int                 @default(1)
  packageQty         Int                 @default(1)
  warehouseLocation  String              @default("")
  weightKg           Decimal             @db.Decimal(8, 3)
  voltage            String              @default("")
  current            String              @default("")
  ipRating           String              @default("")
  status             ProductStatus       @default(DRAFT)
  description        String              @db.Text
  notes              String              @db.Text
  imagePath          String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attributes         ProductAttribute[]
  images             ProductImage[]
  substitutes        ProductSubstitute[] @relation("ProductHasSubstitutes")
  substituteFor      ProductSubstitute[] @relation("ProductIsSubstitute")

  @@index([status])
  @@index([updatedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@index([productId])
}

model ProductSubstitute {
  productId    String
  substituteId String
  product      Product @relation("ProductHasSubstitutes", fields: [productId], references: [id], onDelete: Cascade)
  substitute   Product @relation("ProductIsSubstitute", fields: [substituteId], references: [id], onDelete: Cascade)

  @@id([productId, substituteId])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String
  actorEmail  String      @default("")
  sku         String      @default("")
  productName String      @default("")
  summary     String      @db.Text
  createdAt   DateTime    @default(now())

  @@index([createdAt])
}
